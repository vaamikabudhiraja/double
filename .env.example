# Copy this file to .env.local (which is git-ignored) and fill in the values
# from your Supabase project → Settings → API. Restart with `npx expo start -c`
# after changing them.
#
# Only the public URL and the anon (publishable) key belong here — both are safe
# to ship in the app. Never put the service_role key or any third-party API key
# in the app; those live in Supabase Edge Function env vars (see CLAUDE.md).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
